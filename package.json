{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "predev": "npm run -s data:index",
    "build": "vite build",
    "prebuild": "npm run -s data:index",
    "start": "vite preview",
    "lint": "vinext lint",
    "typecheck": "npm run -s data:index && tsc --noEmit",
    "postinstall": "npm run -s data:index",
    "data:index": "tsx scripts/gen-data-index.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "geo:build": "node scripts/build-geo.mjs",
    "geo:routes": "node scripts/build-routes.mjs",
    "geo:pc": "node scripts/build-constituencies.mjs",
    "data:lok-sabha": "node scripts/fetch-lok-sabha.mjs",
    "geo:ac": "node scripts/build-assembly.mjs",
    "data:karnataka-assembly": "node scripts/fetch-karnataka-assembly.mjs",
    "data:elections": "node scripts/build-election-history.mjs",
    "data:mplads": "node --max-old-space-size=4096 scripts/fetch-mplads.mjs",
    "deploy": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@vinext/cloudflare": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.539.0",
    "maplibre-gl": "^5.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.3.1",
    "vinext": "^1.4.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.1",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "mapshaper": "^0.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vite": "^8.3.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
